# Copy to keystore.properties locally. Never commit the real file or keystore.
# Use an absolute path or a path relative to apps/android. Use forward slashes.
# Java Properties escaping applies: escape backslashes as \\ and a leading space as \ .
storeFile=/absolute/path/to/multisync-release.jks
storePassword=REPLACE_LOCALLY
keyAlias=multisync-release
keyPassword=REPLACE_LOCALLY
